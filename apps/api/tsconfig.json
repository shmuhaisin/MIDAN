{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node10", "ignoreDeprecations": "6.0",
    "outDir": "dist", "rootDir": "src", "strict": true, "esModuleInterop": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src"]
}
