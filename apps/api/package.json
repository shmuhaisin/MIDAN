{
  "name": "@midan/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.json --runInBand",
    "test:live": "jest --config jest.live.json --runInBand",
    "db:pull": "node --env-file=../../.env ../../node_modules/prisma/build/index.js db pull",
    "db:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate",
    "postinstall": "prisma generate"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "bcryptjs": "^3.0.3",
    "jest": "^30.5.2",
    "pg": "^8.13.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
