{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-forms-on/types/**/*.ts",
    ".next-forms-on/dev/types/**/*.ts",
    ".next-forms-off/types/**/*.ts",
    ".next-forms-off/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "e2e",
    "e2e-forms",
    "node_modules",
    "playwright.config.ts",
    "playwright.forms.config.ts",
    "src/lib/application-status.test.ts",
    "src/lib/assessment-review.test.ts",
    "src/lib/csp.test.ts",
    "src/lib/verification.test.ts",
    "src/lib/translation.test.ts",
    "src/components/journey/journey-model.test.ts",
    "src/lib/humaidan.test.ts",
    "src/messages/messages.test.ts"
  ]
}
