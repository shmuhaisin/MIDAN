# Copy to .env and fill in. Never commit real values.

# Supabase project: al-midan-ya-hamidan (ref squpszwbrqkflezfltoj, eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://squpszwbrqkflezfltoj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_P0ibCbg-1JvGg_reuzHK7w_YAui9Vhp
# Server only. Login for the restricted midan_api role of the same project (docs/supabase-cloud.md,
# scripts/provision-db-credentials.mjs). The API doesn't start without it and never uses another database.
# DATABASE_URL=postgresql://midan_api.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# DIRECT_URL=postgresql://midan_api.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DIRECT_URL=
# Migrations only (scripts/apply-cloud-migrations.mjs): the project's postgres connection, Dashboard > Connect >
# Session pooler (port 5432). Never used by the web app, the API or the AI service.
# MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
MIGRATION_DATABASE_URL=

# AI service. With no key, the service must run in a clearly labeled demo mode.
# AI_PROVIDER: groq (Groq Cloud, OpenAI-compatible, e.g. openai/gpt-oss-120b), openai, or gemini.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Where the web server reaches the Core API.
API_URL=http://localhost:4000
# API only. Which hops may report the caller's address (X-Forwarded-For) for rate limiting. Leave empty unless every hop
# named appends the address it received from; see docs/deployment.md. Example: 1 (the web server, behind such a proxy).
TRUST_PROXY=

# Shared secret between the Core API and the private AI service. Any long random value.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
# Optional: Postgres for the AI service's workflow checkpoints. Empty keeps them in a local SQLite file.
CHECKPOINT_DATABASE_URL=
# Live AI needs a key and a model name for the chosen provider. Without both it runs in labeled demo mode.
GEMINI_MODEL=
OPENAI_MODEL=
# For Groq, the model ID exactly as Groq lists it, such as openai/gpt-oss-120b. Optional: GROQ_REASONING_EFFORT (low, medium,
# high) and GROQ_MAX_COMPLETION_TOKENS. The base URL is https://api.groq.com/openai/v1; nothing to set.
GROQ_MODEL=
GROQ_REASONING_EFFORT=
GROQ_MAX_COMPLETION_TOKENS=

# Development only. Shows the sign-up form. Leave off anywhere public.
DEV_TEST_SIGNUP=false
# Server only. The database refuses sign-ups without it. Its SHA-256 hash goes in private.signup_access.
DEV_TEST_ACCESS_CODE=
# Where verification emails send people back to. Must be allowed in Supabase Auth redirect URLs.
APP_URL=http://localhost:3100

# Candidate journey integrations. Each feature says so on screen until it's configured. All of these are server-only.
DAILY_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Whether Google emails attendees: all (default), externalOnly or none. Use none for a local demo or a test calendar.
GOOGLE_CALENDAR_SEND_UPDATES=

# Requirement matching (services/ai/midan_ai/matching.py, docs/ai/ATS_MATCHING.md).
# e5-rerank (selected: e5 retrieval + the cross-encoder BAAI/bge-reranker-v2-m3; `uv sync --extra matching` in services/ai
# and both models' files under HF_HOME, about 3.2 GB; without the reranker it falls back to e5 alone and says so)
# | e5-local (intfloat/multilingual-e5-base alone) | bge-m3-hosted (BAAI/bge-m3 on Hugging Face hosted inference: needs
# HF_TOKEN) | lexical (word comparison; also what runs, labelled, when sentence-transformers isn't installed).
# Set the same value for the API and the AI service: the API keys its stored CV matches on it.
EMBEDDING_PROVIDER=e5-rerank
# Optional: another cross-encoder for e5-rerank, and the seconds one request may spend reranking before e5 alone is used.
RERANKER_MODEL=
RERANK_BUDGET_S=
HF_HOME=
# 1 = never download model files at runtime.
HF_HUB_OFFLINE=1
# A read-only Hugging Face token, only for bge-m3-hosted and the benchmark. Never commit it.
HF_TOKEN=
