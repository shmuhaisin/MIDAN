# Copy to .env and fill in. Never commit real values.

# Supabase project: al-midan-ya-hamidan (ref squpszwbrqkflezfltoj, eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://squpszwbrqkflezfltoj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_P0ibCbg-1JvGg_reuzHK7w_YAui9Vhp
# Server only. Login for the restricted midan_api role; see docs/database/README.md.
DATABASE_URL=
DIRECT_URL=

# AI service. With no key, the service must run in a clearly labeled demo mode.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Where the web server reaches the Core API.
API_URL=http://localhost:4000

# Shared secret between the Core API and the private AI service. Any long random value.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
# Live AI needs a key and a model name for the chosen provider. Without both it runs in labeled demo mode.
GEMINI_MODEL=
OPENAI_MODEL=

# Development only. Shows the sign-up form. Leave off anywhere public.
DEV_TEST_SIGNUP=false
# Server only. The database refuses sign-ups without it. Its SHA-256 hash goes in private.signup_access.
DEV_TEST_ACCESS_CODE=
# Public origin of this web app. Local development is port 3100. Sign-up returns to
# {APP_URL}/ar/auth/confirmed and {APP_URL}/en/auth/confirmed.
# Add both URLs under Supabase Auth → Redirect URLs. Leave the existing Site URL unchanged.
APP_URL=http://localhost:3100

# Organization invitations (Core API only). Never put secrets in Git.
# Generate a stable random secret of at least 32 characters. Rotation requires
# cancelling and recreating outstanding invitations before email can be retried.
INVITATION_TOKEN_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Remote SMTP requires STARTTLS (587) or SMTP_SECURE=true (465).
# Local Supabase capture: expose smtp_port=54325 in the LOCAL config and use
# SMTP_HOST=127.0.0.1, SMTP_PORT=54325, SMTP_SECURE=false, no user/password.
